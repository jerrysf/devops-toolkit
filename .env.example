# ── Site ──────────────────────────────────────────────────────────────
# Canonical site URL — used for sitemap, canonical tags, OG URLs.
NEXT_PUBLIC_SITE_URL=https://www.devopstoolkit.example

# ── Analytics (optional; site works fully without it) ────────────────
# Google Analytics 4 measurement ID. If unset, no analytics code loads.
NEXT_PUBLIC_GA_ID=
# Google Search Console verification token (content of the meta tag).
NEXT_PUBLIC_GSC_VERIFICATION=

# ── Payments (hosted checkout provider) ──────────────────────────────
# Provider label shown in docs/UI: "lemonsqueezy" | "gumroad" | "stripe"
NEXT_PUBLIC_PAYMENT_PROVIDER=
# Hosted checkout URL for the Kubernetes Troubleshooting Toolkit.
# When unset, purchase CTAs show an honest "checkout pending" state.
NEXT_PUBLIC_CHECKOUT_URL_KUBERNETES_TOOLKIT=
# Generic fallback used if no per-product URL is set.
NEXT_PUBLIC_CHECKOUT_URL=

# ── Newsletter (optional) ────────────────────────────────────────────
# Form endpoint (e.g. Buttondown/ConvertKit). Unset = honest "coming soon".
NEXT_PUBLIC_NEWSLETTER_ENDPOINT=

# ── Secrets — NEVER prefixed NEXT_PUBLIC_, never committed ───────────
# Webhook signing secret from Lemon Squeezy (Settings → Webhooks).
LEMONSQUEEZY_WEBHOOK_SECRET=
# Expected product id / price — webhook validates orders against these.
LEMONSQUEEZY_PRODUCT_ID=
PRODUCT_PRICE_CENTS=3900
PRODUCT_CURRENCY=USD
# Optional: HTTPS endpoint that receives verified purchase_completed
# records (e.g. a Zapier/Make hook or your own order DB writer).
FULFILLMENT_HOOK_URL=
